{
  "version": 3,
  "builds": [
    {
      "src": "api/predict.js",
      "use": "@vercel/node"
    },
    {
      "src": "bloodset/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "bloodset/dist" }
    }
  ],
  "routes": [
    {
      "src": "/predict",
      "dest": "/api/predict.js"
    }
  ]
}
